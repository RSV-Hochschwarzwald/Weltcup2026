# ============================================================
# Supabase (Projekt-Einstellungen -> API)
# ============================================================
# Öffentlich, darf im Frontend-Bundle enthalten sein
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# GEHEIM – niemals im Frontend, niemals in Git, nur als Server-Env-Variable
# (z. B. Vercel/Cloudflare Projekt-Umgebungsvariablen, "Encrypted")
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# E-Mail-Versand (Resend – empfohlen, siehe README "E-Mail-Konfiguration")
# ============================================================
RESEND_API_KEY=
EMAIL_FROM="RSV Hochschwarzwald <helfer@rsv-hochschwarzwald.de>"

# Alternative: Versand über Microsoft 365 / Exchange Online per SMTP
# (nur nutzbar mit App-Passwort bzw. konfiguriertem SMTP-Connector, siehe README)
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ============================================================
# Vereins-/Event-Konfiguration
# Für eine NEUE Veranstaltung: nur diese Werte + supabase/seed.sql
# anpassen (siehe README, Abschnitt "Neue Veranstaltung einrichten") -
# keine Code-Änderung nötig.
# ============================================================
NEXT_PUBLIC_EVENT_NAME="Weltcup Skispringen Titisee-Neustadt 2026"
# Kleiner Vorspann auf der Startseite, z. B. "Weltcup Skispringen"
NEXT_PUBLIC_EVENT_KICKER="Weltcup Skispringen"
# Große Überschrift auf der Startseite, z. B. der Veranstaltungsort
NEXT_PUBLIC_EVENT_LOCATION="Titisee-Neustadt"
NEXT_PUBLIC_ORGANIZATION_NAME="RSV Hochschwarzwald e.V."
ADMIN_NOTIFICATION_EMAIL=helfer@rsv-hochschwarzwald.de

# Basis-URL der Anwendung (für Links in E-Mails), z. B. https://helfer.rsv-hochschwarzwald.de
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature-Flags
WAITLIST_ENABLED=false
NEXT_PUBLIC_PUBLIC_FIRST_NAMES_ENABLED=false
NOTIFY_ON_SHIFT_FULL=true
MICROSOFT_INTEGRATION_ENABLED=false

# ============================================================
# Microsoft 365 (nur nötig, falls MICROSOFT_INTEGRATION_ENABLED=true,
# z. B. für Graph-Mailversand oder SharePoint/OneDrive-Ablage des Exports)
# ============================================================
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
